# LUMEN ATLAS runtime configuration
# Copy to .env and adjust before production.

PORT=8099
# Keep the app on loopback when a reverse proxy (Nginx/Caddy) is in front.
HOST=127.0.0.1
NODE_ENV=production

# Required for stable login sessions across restarts.
# Generate with: openssl rand -hex 32
ATLAS_SESSION_SECRET=

# Optional fallback AMap Web Service / JS API key.
# You can also set it in the first-deploy page or Admin -> Site Settings.
AMAP_KEY=

# Optional contact string for the public Nominatim fallback.
NOMINATIM_USER_AGENT=LumenAtlas/1.0 (personal travel photo atlas; contact: admin@example.com)

# Only used when migrating a legacy single-user database.
# New installs should use /setup instead.
# ATLAS_OWNER_USERNAME=owner
# ATLAS_OWNER_PASSWORD=change-me
